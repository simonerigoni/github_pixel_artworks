# Files, directories or patterns that should be excluded from Git tracking

# Temp stuff
temp/

# Clone of a URL target (created at runtime, deleted after a successful push)
target_cloned_repo/

# Python compiled files
*.pyc

# Virtual environment
.venv/

# Pytest cache
.pytest_cache/

# Ruff cache
.ruff_cache/

# pytest-cov stuff
.coverage

# Local secrets and logs
.env
.env.*
*.log

# Extra Python / tooling artefacts
__pycache__/
*.egg-info/
dist/
build/
htmlcov/
.mypy_cache/
.DS_Store
